+
+#define BLE_AUDIO_LINK_TIMEOUT_MS 1500
+#define BLE_LINK_RETRY_MS 250
+
+// Owned by the audio worker; reset when the connection epoch changes.
+typedef struct {
+    bool slowed;
+    bool idle_pending;
+    uint32_t idle_update;
+} ble_audio_link_t;
+
+// Boundary to the BLE host, capture identity, and worker clock. valid() must
+// reject a disconnected/replaced link or a stopped/replaced capture.
+typedef struct {
+    void *context;
+    bool (*valid)(void *context);
+    bool (*matches)(void *context, bool idle);
+    int (*request)(void *context, bool idle);
+    uint32_t (*updates)(void *context);
+    uint32_t (*now_ms)(void *context);
+    void (*wait_ms)(void *context, uint32_t delay_ms);
+} ble_audio_link_ops_t;
+
+// Return the BLE host result (zero also means the idle link is satisfied).
+int ble_audio_link_idle(ble_audio_link_t *state, const ble_audio_link_ops_t *ops);
+
+// Restore an idle link before capture, bounded by BLE_AUDIO_LINK_TIMEOUT_MS.
+// An unmodified initial link keeps the existing best-effort audio request.
+bool ble_audio_link_prepare(ble_audio_link_t *state, const ble_audio_link_ops_t *ops);
