diff --git a/tests/test_ble_audio_link.c b/tests/test_ble_audio_link.c
new file mode 100644
index 0000000..c49340c
--- /dev/null
+++ b/tests/test_ble_audio_link.c
@@ -0,0 +1,128 @@
+#include "ble_audio_link.h"
+#include "standby_policy.h"
+#include <assert.h>
+#include <stdio.h>
+
+typedef struct {
+    uint32_t now, updates, complete_at, cancel_at;
+    uint16_t interval, target;
+    bool pending, valid;
+} host_t;
+
+static bool valid(void *arg) { return ((host_t *)arg)->valid; }
+static bool matches(void *arg, bool idle)
+{
+    return vokie_link_matches(idle, ((host_t *)arg)->interval, 0);
+}
+static uint32_t updates(void *arg) { return ((host_t *)arg)->updates; }
+static uint32_t now_ms(void *arg) { return ((host_t *)arg)->now; }
+static void wait_ms(void *arg, uint32_t delay)
+{
+    host_t *host = arg;
+    host->now += delay;
+    if (host->cancel_at && host->now >= host->cancel_at) host->valid = false;
+    if (host->pending && host->now >= host->complete_at) {
+        host->interval = host->target;
+        host->pending = false;
+        ++host->updates;
+    }
+}
+static int request(void *arg, bool idle)
+{
+    host_t *host = arg;
+    if (host->pending) return 2; // NimBLE BLE_HS_EALREADY.
+    host->target = idle ? VOKIE_IDLE_INTERVAL_MAX : VOKIE_AUDIO_INTERVAL;
+    // Reproduce the captured Mac behavior: a redundant idle request has no
+    // completion for 40 seconds, blocking all following audio requests.
+    host->complete_at = host->now + (idle && matches(host, true) ? 40000 : 220);
+    host->pending = true;
+    return 0;
+}
+static ble_audio_link_ops_t ops(host_t *host)
+{
+    return (ble_audio_link_ops_t){host, valid, matches, request, updates, now_ms, wait_ms};
+}
+
+static void capture_resumes_after_editing_on_an_idle_link(void)
+{
+    host_t host = {.now = 22421, .interval = VOKIE_AUDIO_INTERVAL, .valid = true};
+    ble_audio_link_t state = {0};
+    const ble_audio_link_ops_t callbacks = ops(&host);
+    assert(ble_audio_link_idle(&state, &callbacks) == 0);
+    wait_ms(&host, 220);
+    assert(matches(&host, true));
+
+    // Edits wake the audio worker but leave the negotiated idle interval.
+    // Its next idle deadline repeats the policy call on that same link.
+    host.now = 151656;
+    assert(ble_audio_link_idle(&state, &callbacks) == 0);
+    host.now = 176594;
+    const bool ready = ble_audio_link_prepare(&state, &callbacks);
+    printf("capture after idle edits: ready=%d elapsed=%u ms\n", ready, host.now - 176594);
+    fflush(stdout);
+    assert(ready); // UP must start capture, rather than show Slow BLE.
+    assert(matches(&host, false));
+    assert(host.now - 176594 < BLE_AUDIO_LINK_TIMEOUT_MS);
+
+    // A successful capture must still permit the next low-power idle link.
+    assert(ble_audio_link_idle(&state, &callbacks) == 0);
+    wait_ms(&host, 220);
+    assert(matches(&host, true));
+}
+
+static void capture_waits_for_an_accepted_idle_update(void)
+{
+    host_t host = {.interval = VOKIE_AUDIO_INTERVAL, .valid = true};
+    ble_audio_link_t state = {0};
+    const ble_audio_link_ops_t callbacks = ops(&host);
+    assert(ble_audio_link_idle(&state, &callbacks) == 0);
+    // The descriptor is still fast while the idle procedure is pending.
+    // A retry rejected by NimBLE must not erase that outstanding update.
+    assert(ble_audio_link_idle(&state, &callbacks) == 2);
+    assert(ble_audio_link_prepare(&state, &callbacks));
+    assert(matches(&host, false));
+    assert(host.now >= 440 && host.now < BLE_AUDIO_LINK_TIMEOUT_MS);
+}
+
+static void satisfied_idle_does_not_invent_a_pending_update(void)
+{
+    host_t host = {.interval = VOKIE_IDLE_INTERVAL_MAX, .valid = true};
+    ble_audio_link_t state = {0};
+    const ble_audio_link_ops_t callbacks = ops(&host);
+    assert(ble_audio_link_idle(&state, &callbacks) == 0);
+    // The central restores the fast interval before UP. No idle request was
+    // sent, so no callback is owed before that fast descriptor can be used.
+    host.interval = VOKIE_AUDIO_INTERVAL;
+    assert(ble_audio_link_prepare(&state, &callbacks));
+    assert(host.now == 0);
+}
+
+static void genuinely_blocked_audio_link_keeps_the_deadline(void)
+{
+    host_t host = {.interval = VOKIE_IDLE_INTERVAL_MAX, .valid = true,
+                   .pending = true, .complete_at = 40000};
+    ble_audio_link_t state = {.slowed = true};
+    const ble_audio_link_ops_t callbacks = ops(&host);
+    assert(!ble_audio_link_prepare(&state, &callbacks));
+    assert(host.now == BLE_AUDIO_LINK_TIMEOUT_MS);
+}
+
+static void stopped_or_replaced_capture_cancels_the_wait(void)
+{
+    host_t host = {.interval = VOKIE_IDLE_INTERVAL_MAX, .valid = true, .cancel_at = 60};
+    ble_audio_link_t state = {.slowed = true};
+    const ble_audio_link_ops_t callbacks = ops(&host);
+    assert(!ble_audio_link_prepare(&state, &callbacks));
+    assert(host.now == 60);
+}
+
+int main(void)
+{
+    capture_resumes_after_editing_on_an_idle_link();
+    capture_waits_for_an_accepted_idle_update();
+    satisfied_idle_does_not_invent_a_pending_update();
+    genuinely_blocked_audio_link_keeps_the_deadline();
+    stopped_or_replaced_capture_cancels_the_wait();
+    puts("BLE audio link lifecycle tests: PASS");
+    return 0;
+}
