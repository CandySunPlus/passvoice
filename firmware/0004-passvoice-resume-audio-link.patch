diff --git a/main/ble_audio_link.c b/main/ble_audio_link.c
new file mode 100644
index 0000000..d4af400
--- /dev/null
+++ b/main/ble_audio_link.c
@@ -0,0 +1,53 @@
+#include "ble_audio_link.h"
+
+int ble_audio_link_idle(ble_audio_link_t *state, const ble_audio_link_ops_t *ops)
+{
+    const uint32_t update = ops->updates(ops->context);
+    if (state->idle_update != update) state->idle_pending = false;
+    // Edits restart the idle timer without changing the negotiated interval.
+    // A redundant update can occupy NimBLE's one pending procedure until its
+    // 40-second timeout, preventing the following UP from requesting audio.
+    if (ops->matches(ops->context, true)) {
+        state->slowed = true;
+        return 0;
+    }
+    const int rc = ops->request(ops->context, true);
+    if (rc == 0) {
+        state->slowed = true;
+        state->idle_pending = true;
+        state->idle_update = update;
+    }
+    return rc;
+}
+
+bool ble_audio_link_prepare(ble_audio_link_t *state, const ble_audio_link_ops_t *ops)
+{
+    void *context = ops->context;
+    if (!state->slowed) {
+        if (!ops->matches(context, false)) (void)ops->request(context, false);
+        return true;
+    }
+    const uint32_t start = ops->now_ms(context);
+    uint32_t last_request = start - BLE_LINK_RETRY_MS;
+    bool pending = false;
+    state->idle_pending = state->idle_pending && state->idle_update == ops->updates(context);
+    uint32_t requested_at_update = 0;
+    do {
+        if (!ops->valid(context)) return false;
+        if (pending && requested_at_update != ops->updates(context)) pending = false;
+        if (state->idle_pending && state->idle_update != ops->updates(context)) state->idle_pending = false;
+        if (!pending && !state->idle_pending && ops->matches(context, false)) return true;
+        const uint32_t now = ops->now_ms(context);
+        if (!pending && now - last_request >= BLE_LINK_RETRY_MS) {
+            last_request = now;
+            requested_at_update = ops->updates(context);
+            const int rc = ops->request(context, false);
+            if (rc == 0) {
+                state->idle_pending = false;
+                pending = true;
+            }
+        }
+        ops->wait_ms(context, 20);
+    } while (ops->now_ms(context) - start < BLE_AUDIO_LINK_TIMEOUT_MS);
+    return false;
+}
