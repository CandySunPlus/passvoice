+static void test_passvoice_cancel_requires_the_same_live_session(void) {
+    const button_edit_host_t active = {.connection = 1, .passvoice = true,
+                                       .recording = true, .cancel_session = 42};
+    const button_edit_host_t stopping = {.connection = 1, .passvoice = true,
+                                         .recording = true, .stopped_session = 42};
+    button_gesture_t ok = {0}, down = {0};
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 0, 650, active, true);
+    assert(button_edit_update(&ok, BUTTON_EDGE_RELEASE, 60, 650, active, true).action == BUTTON_ACTION_NONE);
+    (void)button_edit_update(&down, BUTTON_EDGE_PRESS, 0, 650, active, false);
+    assert(button_edit_update(&down, BUTTON_EDGE_LONG, 650, 650, active, false).action == BUTTON_ACTION_NONE);
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 100, 650, active, true);
+    assert(button_edit_update(&ok, BUTTON_EDGE_LONG, 750, 650, active, true).cancel_capture);
+    assert(button_edit_update(&ok, BUTTON_EDGE_RELEASE, 800, 650, active, true).action == BUTTON_ACTION_NONE);
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 900, 650, active, true);
+    assert(button_edit_update(&ok, BUTTON_EDGE_RELEASE, 1550, 650, stopping, true).action == BUTTON_ACTION_NONE);
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 1600, 650, active, true);
+    button_edit_host_t next = active;
+    next.cancel_session = 43;
+    assert(button_edit_update(&ok, BUTTON_EDGE_RELEASE, 2250, 650, next, true).action == BUTTON_ACTION_NONE);
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 2300, 650, stopping, true);
+    const button_edit_t edit = button_edit_update(&ok, BUTTON_EDGE_LONG, 2950, 650, stopping, true);
+    assert(edit.action == BUTTON_ACTION_LONG && !edit.cancel_capture && edit.required_stop == 42);
+}
