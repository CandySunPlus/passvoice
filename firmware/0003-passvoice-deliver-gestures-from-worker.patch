+static void send_button_notification(const button_notification_t *notification)
+{
+    char json[MAX_CONTROL + 1];
+    char session_field[32] = "";
+    if (notification->stopped_session) {
+        snprintf(session_field, sizeof(session_field), ",\"sessionId\":%lu",
+                 (unsigned long)notification->stopped_session);
+    }
+    const bool long_press = notification->action == BUTTON_ACTION_LONG;
+    const int len = snprintf(json, sizeof(json),
+             "{\"v\":1,\"type\":\"button_event\",\"button\":\"%s\",\"event\":\"%s\",\"durationMs\":%lu,\"seq\":%lu%s}",
+             button_name(notification->button), long_press ? "long" : "click",
+             (unsigned long)notification->duration_ms, (unsigned long)notification->seq, session_field);
+    int rc = BLE_HS_EMSGSIZE;
+    if (len > 0 && len <= MAX_CONTROL) {
+        rc = notify_bytes(notification->conn, notification->epoch, s_control_handle,
+                          (const uint8_t *)json, (size_t)len);
+    }
+    device_diag_emit(DD_BUTTON_SEND, notification->session, notification->button, long_press,
+                     notification->duration_ms, rc, notification->seq, diagnostic_flags(),
+                     notification->epoch, 0);
+}
+
+static void drain_button_notifications(uint32_t delivered_stop)
+{
+    button_notification_t notification;
+    for (int index = 0; index < BUTTON_QUEUE_LENGTH &&
+         xQueueReceive(s_button_queue, &notification, 0) == pdTRUE; ++index) {
+        if (!s_passvoice_host || !host_is_ready() || !s_control_subscribed ||
+            notification.conn != s_conn || notification.session != s_session ||
+            !button_edit_can_deliver(notification.epoch, s_connection_epoch,
+                                     notification.stopped_session, delivered_stop)) continue;
+        send_button_notification(&notification);
+    }
+}
