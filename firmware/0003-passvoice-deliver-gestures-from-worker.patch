         action != BUTTON_ACTION_NONE && !host.passvoice && host.recording && is_ok};
 }
+
+static inline bool button_edit_can_deliver(uint32_t queued_connection, uint32_t connection,
+        uint32_t stopped_session, uint32_t delivered_stop)
+{
+    return queued_connection == connection && (stopped_session == 0 || stopped_session == delivered_stop);
+}
