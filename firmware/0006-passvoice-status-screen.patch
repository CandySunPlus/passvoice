+    lv_obj_t *caption = label(s_screen, "PassVoice", &lv_font_montserrat_14, UI_WHITE, 0);
+    lv_obj_set_pos(caption, 19, UI_BATTERY_Y + 1);
+    draw_battery();
+    draw_passvoice();
+    draw_footer();
+    draw_button_rail();
+
+    s_state = label(s_screen, "", &lv_font_montserrat_30, UI_WHITE, UI_CONTENT_W);
+    lv_obj_set_pos(s_state, UI_CONTENT_X, UI_STATE_Y);
+    s_detail = label(s_screen, "", &lv_font_montserrat_14, UI_MUTED, UI_CONTENT_W);
+    lv_label_set_long_mode(s_detail, LV_LABEL_LONG_DOT);
+    lv_obj_set_pos(s_detail, UI_CONTENT_X, UI_DETAIL_Y);
+    lv_screen_load(s_screen);
+}
