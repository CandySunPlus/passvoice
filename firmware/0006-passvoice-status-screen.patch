-    lv_label_set_text(s_detail, state->message[0] ? state->message : "Vokie is ready");
+    const char *detail = state->message;
+    const char *hint = "Please wait";
+    bool show_up = false;
+    switch (state->state) {
+    case UI_STATUS_READY:
+    case UI_STATUS_SUCCESS:
+        if (!*detail || strcmp(detail, "Ready") == 0) detail = "Mac connected";
+        hint = "Start recording";
+        show_up = true;
+        break;
+    case UI_STATUS_RECORDING:
+        if (strcmp(detail, "Listening") == 0) detail = "Sending audio to Mac";
+        hint = "Stop recording";
+        show_up = true;
+        break;
+    case UI_STATUS_PROCESSING:
+        if (strcmp(detail, "Processing") == 0) detail = "Sending final audio";
+        break;
+    case UI_STATUS_ERROR:
+        hint = "Try recording again";
+        show_up = true;
+        break;
+    case UI_STATUS_DISCONNECTED:
+        detail = "Waiting for Mac";
+        hint = "Open PassVoice on Mac";
+        break;
+    case UI_STATUS_STARTING:
+        detail = "Connecting to Mac";
+        break;
+    }
+    lv_label_set_text(s_state, state_name(state));
+    lv_label_set_text(s_detail, detail);
+    for (int i = 0; i < 4; ++i) {
+        lv_obj_set_style_bg_color(s_waveform[i], lv_color_hex(color), 0);
+    }
+    if (show_up) {
+        lv_obj_remove_flag(s_footer_key, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_style_bg_color(s_footer_key, lv_color_hex(color), 0);
+    } else {
+        lv_obj_add_flag(s_footer_key, LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_obj_set_x(s_footer_hint, show_up ? 44 : 0);
+    lv_obj_set_width(s_footer_hint, show_up ? 148 : 202);
+    lv_obj_set_style_text_align(s_footer_hint, show_up ? LV_TEXT_ALIGN_LEFT : LV_TEXT_ALIGN_CENTER, 0);
+    lv_label_set_text(s_footer_hint, hint);
     set_button_hints_visible(hints);
     lv_obj_set_style_opa(s_screen, LV_OPA_COVER, 0);
 }
 
