                                                        650, recording, is_ok);
         assert(hold.action == BUTTON_ACTION_NONE && !hold.cancel_capture);
+        const button_edit_t release = button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 900,
+                                                          650, recording, is_ok);
+        assert(release.action == BUTTON_ACTION_NONE && !release.cancel_capture);
     }
 }

@@ -51,10 +78,25 @@ static void test_legacy_hosts_keep_capture_button_actions(void) {
     assert(cancel.action == BUTTON_ACTION_CLICK && cancel.cancel_capture);
 }

+static void test_legacy_hosts_receive_only_down_click(void) {
+    const button_edit_host_t legacy = {.connection = 1};
+    button_gesture_t down = {0};
+    (void)button_edit_update(&down, BUTTON_EDGE_PRESS, 0, 650, legacy, false);
+    assert(button_edit_update(&down, BUTTON_EDGE_RELEASE, 60, 650, legacy, false)
+               .action == BUTTON_ACTION_CLICK);
+    (void)button_edit_update(&down, BUTTON_EDGE_PRESS, 120, 650, legacy, false);
+    assert(button_edit_update(&down, BUTTON_EDGE_LONG, 770, 650, legacy, false)
+               .action == BUTTON_ACTION_NONE);
+    assert(button_edit_update(&down, BUTTON_EDGE_RELEASE, 800, 650, legacy, false)
+               .action == BUTTON_ACTION_NONE);
+}
