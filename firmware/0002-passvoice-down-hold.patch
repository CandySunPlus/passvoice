+static void test_passvoice_reports_one_click_or_hold_per_edit_press(void) {
+    const button_edit_host_t idle = {.connection = 1, .passvoice = true};
+    for (int is_ok = 0; is_ok <= 1; ++is_ok) {
+        button_gesture_t gesture = {0};
+        assert(button_edit_update(&gesture, BUTTON_EDGE_PRESS, 0, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_NONE);
+        assert(button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 60, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_CLICK);
+
+        // Hold the next press within the driver's double-click window.
+        assert(button_edit_update(&gesture, BUTTON_EDGE_PRESS, 120, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_NONE);
+        assert(button_edit_update(&gesture, BUTTON_EDGE_LONG, 760, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_NONE);
+        const button_edit_t hold = button_edit_update(&gesture, BUTTON_EDGE_LONG, 770,
+                                                       650, idle, is_ok);
+        assert(hold.action == BUTTON_ACTION_LONG && !hold.cancel_capture);
+        assert(button_edit_update(&gesture, BUTTON_EDGE_LONG, 790, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_NONE);
+        assert(button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 820, 650, idle, is_ok)
+                   .action == BUTTON_ACTION_NONE);
+    }
+}
+
 static void test_passvoice_ignores_edit_presses_during_capture(void) {
     const button_edit_host_t recording = {.connection = 1, .passvoice = true, .recording = true};
