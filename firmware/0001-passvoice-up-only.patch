diff --git a/tests/test_button_gesture.c b/tests/test_button_gesture.c
index 7732020..b6169d6 100644
--- a/tests/test_button_gesture.c
+++ b/tests/test_button_gesture.c
@@ -6,7 +6,55 @@ static button_gesture_t key;
 static button_action_t edge(button_edge_t event, uint32_t at, uint32_t context) {
     return button_gesture_update(&key, event, at, context, 650);
 }
+
+static void test_passvoice_ignores_edit_presses_during_capture(void) {
+    const button_edit_host_t recording = {.connection = 1, .passvoice = true, .recording = true};
+    for (int is_ok = 0; is_ok <= 1; ++is_ok) {
+        button_gesture_t gesture = {0};
+        (void)button_edit_update(&gesture, BUTTON_EDGE_PRESS, 0, 650, recording, is_ok);
+        const button_edit_t click = button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 60,
+                                                        650, recording, is_ok);
+        assert(click.action == BUTTON_ACTION_NONE && !click.cancel_capture);
+        (void)button_edit_update(&gesture, BUTTON_EDGE_PRESS, 200, 650, recording, is_ok);
+        const button_edit_t hold = button_edit_update(&gesture, BUTTON_EDGE_LONG, 850,
+                                                       650, recording, is_ok);
+        assert(hold.action == BUTTON_ACTION_NONE && !hold.cancel_capture);
+    }
+}
+
+static void test_passvoice_only_accepts_a_fresh_press_after_up(void) {
+    button_gesture_t gesture = {0};
+    const button_edit_host_t recording = {.connection = 1, .passvoice = true, .recording = true};
+    // The stop is requested by UP, while the worker is still sending audio.
+    const button_edit_host_t stopped = {.connection = 1, .passvoice = true, .recording = true,
+                                         .stopped_session = 42};
+    (void)button_edit_update(&gesture, BUTTON_EDGE_PRESS, 0, 650, recording, false);
+    const button_edit_t previous = button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 60,
+                                                       650, stopped, false);
+    assert(previous.action == BUTTON_ACTION_NONE && !previous.cancel_capture);
+    (void)button_edit_update(&gesture, BUTTON_EDGE_PRESS, 80, 650, stopped, false);
+    const button_edit_t fresh = button_edit_update(&gesture, BUTTON_EDGE_RELEASE, 140,
+                                                    650, stopped, false);
+    assert(fresh.action == BUTTON_ACTION_CLICK && !fresh.cancel_capture);
+}
+
+static void test_legacy_hosts_keep_capture_button_actions(void) {
+    const button_edit_host_t recording = {.connection = 1, .recording = true};
+    button_gesture_t down = {0}, ok = {0};
+    (void)button_edit_update(&down, BUTTON_EDGE_PRESS, 0, 650, recording, false);
+    (void)button_edit_update(&ok, BUTTON_EDGE_PRESS, 0, 650, recording, true);
+    const button_edit_t send = button_edit_update(&down, BUTTON_EDGE_RELEASE, 60,
+                                                   650, recording, false);
+    const button_edit_t cancel = button_edit_update(&ok, BUTTON_EDGE_RELEASE, 60,
+                                                     650, recording, true);
+    assert(send.action == BUTTON_ACTION_CLICK && !send.cancel_capture);
+    assert(cancel.action == BUTTON_ACTION_CLICK && cancel.cancel_capture);
+}
+
 int main(void) {
+    test_passvoice_ignores_edit_presses_during_capture();
+    test_passvoice_only_accepts_a_fresh_press_after_up();
+    test_legacy_hosts_keep_capture_button_actions();
     assert(edge(BUTTON_EDGE_RELEASE, 0, 1) == BUTTON_ACTION_NONE);
     // Each release acts immediately, including a second press inside 180 ms.
     assert(edge(BUTTON_EDGE_PRESS, 20, 1) == BUTTON_ACTION_NONE);
